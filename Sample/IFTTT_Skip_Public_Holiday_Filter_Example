const time = Meta.currentUserTime;
const month = time.month(); // Jan=0, Feb=1, etc.
const date = time.date();

/**
 * 2026 JAPAN PUBLIC HOLIDAYS
 */
const isJapanHoliday = (
  (month === 0 && date === 1)  || // Jan 1: New Year
  (month === 0 && date === 12) || // Jan 12: Coming of Age Day
  (month === 1 && date === 11) || // Feb 11: National Foundation
  (month === 1 && date === 23) || // Feb 23: Emperor's Birthday
  (month === 2 && date === 20) || // Mar 20: Vernal Equinox
  (month === 3 && date === 29) || // Apr 29: Showa Day
  (month === 4 && date === 3)  || // May 3: Constitution Day
  (month === 4 && date === 4)  || // May 4: Greenery Day
  (month === 4 && date === 5)  || // May 5: Children's Day
  (month === 4 && date === 6)  || // May 6: Observed
  (month === 6 && date === 20) || // Jul 20: Marine Day
  (month === 7 && date === 11) || // Aug 11: Mountain Day
  (month === 8 && date === 21) || // Sep 21: Respect for Aged Day
  (month === 8 && date === 22) || // Sep 22: Citizen's Holiday
  (month === 8 && date === 23) || // Sep 23: Autumnal Equinox
  (month === 9 && date === 12) || // Oct 12: Sports Day
  (month === 10 && date === 3) || // Nov 3: Culture Day
  (month === 10 && date === 23)   // Nov 23: Labor Thanksgiving Day
);

/**
 * 2026 UK (ENGLAND & WALES) BANK HOLIDAYS
 */
const isUKHoliday = (
  (month === 0 && date === 1)  || // Jan 1: New Year
  (month === 3 && date === 3)  || // Apr 3: Good Friday
  (month === 3 && date === 6)  || // Apr 6: Easter Monday
  (month === 4 && date === 4)  || // May 4: Early May Bank Holiday
  (month === 4 && date === 25) || // May 25: Spring Bank Holiday
  (month === 7 && date === 31) || // Aug 31: Summer Bank Holiday
  (month === 11 && date === 25) || // Dec 25: Christmas Day
  (month === 11 && date === 28)    // Dec 28: Boxing Day (Observed)
);

/**
 * 2026 US FEDERAL HOLIDAYS
 */
const isUSHoliday = (
  (month === 0 && date === 1)  || // Jan 1: New Year
  (month === 0 && date === 19) || // Jan 19: MLK Jr. Day
  (month === 1 && date === 16) || // Feb 16: Washington's Birthday
  (month === 4 && date === 25) || // May 25: Memorial Day
  (month === 5 && date === 19) || // Jun 19: Juneteenth
  (month === 6 && date === 3)  || // Jul 3: Independence Day (Observed)
  (month === 8 && date === 7)  || // Sep 7: Labor Day
  (month === 9 && date === 12) || // Oct 12: Columbus Day
  (month === 10 && date === 11) || // Nov 11: Veterans Day
  (month === 10 && date === 26) || // Nov 26: Thanksgiving Day
  (month === 11 && date === 25)    // Dec 25: Christmas Day
);

/**
 * 2026 CANADA STATUTORY HOLIDAYS (Federal & Major Provincial)
 */
const isCAHoliday = (
  (month === 0 && date === 1)  || // Jan 1: New Year
  (month === 1 && date === 16) || // Feb 16: Family Day (Major provinces)
  (month === 3 && date === 3)  || // Apr 3: Good Friday
  (month === 3 && date === 6)  || // Apr 6: Easter Monday (Federal)
  (month === 4 && date === 18) || // May 18: Victoria Day
  (month === 6 && date === 1)  || // Jul 1: Canada Day
  (month === 7 && date === 3)  || // Aug 3: Civic Holiday (Most provinces)
  (month === 8 && date === 7)  || // Sep 7: Labour Day
  (month === 8 && date === 30) || // Sep 30: Truth and Reconciliation Day
  (month === 9 && date === 12) || // Oct 12: Thanksgiving
  (month === 10 && date === 11) || // Nov 11: Remembrance Day
  (month === 11 && date === 25) || // Dec 25: Christmas Day
  (month === 11 && date === 28)    // Dec 28: Boxing Day (Observed/ON)
);

/**
 * ACTION ROUTING
 * Skip logic: "If NOT a holiday, then skip."
 */

// 1. JP Action
if (!isJapanHoliday) {
  MakerWebhooks.makeWebRequest1.skip("Not a Japan holiday");
}

// 2. UK Action
if (!isUKHoliday) {
  MakerWebhooks.makeWebRequest2.skip("Not a UK holiday");
}

// 3. US Action
if (!isUSHoliday) {
  MakerWebhooks.makeWebRequest3.skip("Not a US holiday");
}

// 4. CA Action
if (!isCAHoliday) {
  MakerWebhooks.makeWebRequest4.skip("Not a Canada holiday");
}
